indicator(title = "Custom VixFix", shorttitle = "Custom VixFix", precision = 2)

// =============================================================================
// INPUT PARAMETERS
// =============================================================================

// Calculation Periods
length1 = input.int(title="Length 1", defval=22, minval=1, maxval=500, tooltip="Average number of trading days in 1 month. Controls short-term volatility calculation.")
length2 = input.int(title="Length 2", defval=66, minval=1, maxval=500, tooltip="Average number of trading days in 3 months. Controls medium-term volatility calculation.")
length3 = input.int(title="Length 3", defval=132, minval=1, maxval=500, tooltip="Average number of trading days in 6 months. Controls long-term volatility calculation.")

// Weis Wyckoff Configuration
string methodtype = input.string("ATR", "Renko Assignment Method", options = ["ATR", "Traditional", "Part of Price"], group = "Weis Method", tooltip = "How the reversal brick size is measured. ATR uses recent volatility. Traditional uses a fixed price amount. Part of Price uses close divided by Value.")
float methodvalue = input.float(14.0, "Value", minval = 0, group = "Weis Method", tooltip = "ATR length when the method is ATR. Fixed brick size when Traditional. Divisor of close when Part of Price.")
string pricesource = input.string("Close", "Price Source", options = ["Close", "Open / Close", "High / Low"], group = "Weis Method", tooltip = "Prices used to detect a one-brick reversal. Close uses close only. Open / Close uses the bar’s open and close. High / Low uses the full range.")
string useTrueRange = input.string("Auto", "Use True Range instead of Volume", options = ["Always", "Auto", "Never"], group = "Weis Volume", tooltip = "Always sums true range. Auto uses true range only when volume is unavailable. Never uses volume.")
bool isOscillating = input.bool(true, "Oscillating", group = "Weis Volume", tooltip = "When enabled, down-waves plot below the Weis zero line and up-waves plot above it. When disabled, all waves plot above the Weis zero line.")
bool normalize = input.bool(false, "Normalize", group = "Weis Volume", tooltip = "When enabled, the column is average volume (or true range) per bar in the current wave instead of the wave’s cumulative total.")
float weisDivisor = input.float(1000000.0, "Display Divisor", minval = 0.000001, group = "Weis Display", tooltip = "Divides Weis wave volume before plotting it. Adjust per instrument so most columns fit between 100 and 300. Values outside that range are clipped.")

// =============================================================================
// CORE CALCULATIONS
// =============================================================================

// VixFix calculations for buy signals
buy1 = ((high - ta.lowest(close[1], length1)) / ta.lowest(close[1], length1)) * 100
buy2 = ((high - ta.lowest(close[1], length2)) / ta.lowest(close[1], length2)) * 100
buy3 = ((high - ta.lowest(close[1], length3)) / ta.lowest(close[1], length3)) * 100

// Weis Wyckoff wave volume
bool useClose = pricesource == "Close"
bool useOpenClose = pricesource == "Open / Close" or useClose

float brickSize = methodvalue
if methodtype == "ATR"
    brickSize := ta.atr(math.max(1, int(math.round(methodvalue))))
else if methodtype == "Part of Price"
    brickSize := close / methodvalue

float op = useClose ? close : open
float hi = useOpenClose ? (close >= op ? close : op) : high
float lo = useOpenClose ? (close <= op ? close : op) : low

float currclose = na
float prevclose = nz(currclose[1])
float prevhigh = prevclose + brickSize
float prevlow = prevclose - brickSize
currclose := hi > prevhigh ? hi : lo < prevlow ? lo : prevclose

int direction = na
direction := currclose > prevclose ? 1 : currclose < prevclose ? -1 : nz(direction[1])
bool directionHasChanged = ta.change(direction) != 0
bool directionIsUp = direction > 0
bool directionIsDown = direction < 0

float vol = (useTrueRange == "Always" or (useTrueRange == "Auto" and na(volume))) ? ta.tr : volume
int barcount = 1
barcount := not directionHasChanged and normalize ? nz(barcount[1]) + 1 : 1
vol := not directionHasChanged ? nz(vol[1]) + nz(vol) : nz(vol)
float res = barcount > 1 ? vol / barcount : vol
float signedWeis = isOscillating and directionIsDown ? -res : res
float scaledWeis = math.max(-100.0, math.min(100.0, signedWeis / weisDivisor))

// TVC:VIX is used instead of the delayed CBOE:VIX feed.
float vix = request.security("TVC:VIX", timeframe.period, close)
float scaledVix = na(vix) ? na : 300.0 + math.max(0.0, math.min(100.0, vix))

// =============================================================================
// VISUAL DISPLAY & STYLING
// =============================================================================

// Reference lines for each display band
hline(0, "VixFix Zero", color = color.new(color.gray, 50), linewidth = 1)
hline(100, "VixFix / Weis Boundary", color = color.new(color.gray, 75), linewidth = 1)
hline(200, "Weis Zero", color = color.new(color.gray, 50), linewidth = 1)
hline(300, "Weis / VIX Boundary", color = color.new(color.gray, 75), linewidth = 1)
hline(400, "VIX Upper Boundary", color = color.new(color.gray, 75), linewidth = 1)

// VixFix buy plots, clipped to their -100 to 100 band
plot(math.max(-100.0, math.min(100.0, buy1)), title = "Buy Short (22d)", color = color.new(color.green, 60), linewidth = 1)
plot(math.max(-100.0, math.min(100.0, buy2)), title = "Buy Medium (66d)", color = color.new(color.green, 50), linewidth = 1)
plot(math.max(-100.0, math.min(100.0, buy3)), title = "Buy Long (132d)", color = color.new(color.green, 40), linewidth = 1)

// Weis columns occupy 100 to 300, with their zero line at 200.
plot(200.0 + scaledWeis, style = plot.style_columns, color = directionIsUp ? color.new(color.green, 75) : color.new(color.red, 75), linewidth = 3, histbase = 200, title = "Weis Wave Volume")

// VIX occupies 300 to 400 and is clipped at the upper boundary.
plot(scaledVix, title = "TVC:VIX", color = color.orange, linewidth = 2)

// Higher lookbacks take precedence and produce brighter green shading.
bg_color = buy3 < 0 ? color.new(color.green, 65) :
           buy2 < 0 ? color.new(color.green, 75) :
           buy1 < 0 ? color.new(color.green, 85) : na

bgcolor(bg_color, title = "Buy Signal Background")
